{
	chapter.0750595BB1E99F0F.chapter_subtitle: ["Act 2. The subways. Something lives down there."]
	chapter.0750595BB1E99F0F.title: "Below the Line"
	chapter.1974464A24A05158.chapter_subtitle: ["Act 4. The Builders didn't all leave by rail."]
	chapter.1974464A24A05158.title: "Other Doors"
	chapter.2FDC441E816C66D8.chapter_subtitle: ["Act 5. Airships, cannons, and the stars."]
	chapter.2FDC441E816C66D8.title: "Above"
	chapter.4DB226BD3A09B8E8.chapter_subtitle: ["The last train dropped you here. It left without you."]
	chapter.4DB226BD3A09B8E8.title: "Arrival"
	chapter.5829F60643377E5B.chapter_subtitle: ["Act 3. The grid fails. The infection spreads. Hold the line."]
	chapter.5829F60643377E5B.title: "Lights Out"
	chapter.7E45EDCAAD68086A.chapter_subtitle: ["Act 1. The machines still turn. Learn why."]
	chapter.7E45EDCAAD68086A.title: "The Platform"
	quest.03622A4EF48DF367.quest_desc: ["Build a working airship with &eCreate Aeronautics&r and fly it over the city. Check this once you are off the ground."]
	quest.03622A4EF48DF367.title: "Airship"
	quest.08794E63595E59BC.quest_desc: ["Find walls, a door and a bed before the first night.\\n\\nSomething may knock. &cDo not answer.&r"]
	quest.08794E63595E59BC.title: "Somewhere To Hide"
	quest.0A344FDEFF65DB42.quest_desc: ["Deep in a cave, a giant suit of armor still guards whatever it was told to guard. Hit it from behind."]
	quest.0A344FDEFF65DB42.title: "The Iron Guardian"
	quest.0B9F12FC3A0D76DB.quest_desc: ["Deep in a station office, a logbook:\\n&o\"Day 41. The things from below follow the dark. We're moving everyone out by rail. The Engine at the end of the line will hold them back as long as it turns. Don't let it stop.\"&r\\n\\nThe last entry is just one word, written over and over: &cLIGHTS&r."]
	quest.0B9F12FC3A0D76DB.quest_subtitle: "Chapter Gate"
	quest.0B9F12FC3A0D76DB.title: "The Evacuation Log"
	quest.0BF299613535445C.quest_desc: ["Statues in the archives. They only move when nobody is looking.\\n\\n&cDo not charge these.&r Keep eyes on them, never turn your back, and break them with a pickaxe."]
	quest.0BF299613535445C.title: "Don't Blink"
	quest.0D0ADCDCEBD811C1.quest_desc: ["You will start to see &esomeone&r at the edge of your vision. Standing still. Closer each day.\\n\\nThat is &cKenny&r. He does not stop. He gets bolder every night. Check this the first time you see him, and &onever&r go out alone after that."]
	quest.0D0ADCDCEBD811C1.title: "Being Watched"
	quest.1300434F59C13300.quest_desc: ["Train controls. Casing, a seat, controls, a bogey on the rails, and you have a train."]
	quest.1300434F59C13300.title: "Driver's Seat"
	quest.13EDA76AF227D376.quest_desc: ["From the sky you can finally see it: the capital, and the &eEngine&r at the end of every rail line, barely turning.\\n\\n&7The final chapter (the Engine, the Sunbreaker, and what you choose to do) arrives in a future update.&r"]
	quest.13EDA76AF227D376.quest_subtitle: "Chapter Gate"
	quest.13EDA76AF227D376.title: "The End of the Line"
	quest.17417239150B9BF0.quest_desc: ["The subway tunnels under the city still have &eworking Create track&r. Patch the gaps and the old lines run again."]
	quest.17417239150B9BF0.title: "Lay Track"
	quest.18B606392431482E.quest_desc: ["The moon goes red and everything comes at once. Survive a &cBlood Moon&r with your group, then check this.\\n\\nEvery blood moon is a &eHorror Night&r. Your base is what they come for."]
	quest.18B606392431482E.title: "Blood Moon"
	quest.1E34D759428F025C.quest_desc: ["Something huge coils in the courtyard ruins."]
	quest.1E34D759428F025C.title: "The Serpent"
	quest.20BC1DE9290ABEE6.quest_desc: ["A schedule makes a train run without a driver, like the ghost trains still circling the city.\\n\\nWho wrote theirs? And why do they all stop &oonce&r, in the deepest tunnel, for exactly one minute?"]
	quest.20BC1DE9290ABEE6.title: "On Schedule"
	quest.2227FE9F824CE158.quest_desc: ["Copper and zinc, mixed with heat. The Builders made their trains from brass."]
	quest.2227FE9F824CE158.title: "Brass"
	quest.253B69673D87FB1D.quest_desc: ["They got this far. Then the logs stop."]
	quest.253B69673D87FB1D.title: "Mars"
	quest.2572FA76C9A64D4E.quest_desc: ["An empty Builder outpost. Signs of a hasty departure. A logbook pointing further out."]
	quest.2572FA76C9A64D4E.title: "The Moon"
	quest.2CE34496659452AF.quest_desc: ["Big cannons on a mount. On an airship, they recoil for real. Aim well."]
	quest.2CE34496659452AF.title: "Broadside"
	quest.31D27DBA25D73C48.quest_desc: ["A water wheel in flowing water makes rotation for free. The Builders put them in every canal."]
	quest.31D27DBA25D73C48.title: "Find the Current"
	quest.3450C0960C7F9112.quest_desc: ["Every way out you have found, the Builders found first. None of them were far enough.\\n\\nThe rails to the capital were cut. The only way left is &eup&r."]
	quest.3450C0960C7F9112.quest_subtitle: "Chapter Gate"
	quest.3450C0960C7F9112.title: "Every Door Leads Back"
	quest.37521462F21C1396.quest_desc: ["The Builders' last project: rockets. Something up there was supposed to help."]
	quest.37521462F21C1396.title: "Higher Still"
	quest.3982EBB723ECD32B.quest_desc: ["Your settlement made it through the dark.\\n\\nOn a dead radio in the Builders' signal tower, a repeating message: &o\"...doors open beyond the forest, beyond the sky... the Engine is at the end of the line... if you can hear this, &lfinish what we started&r&o.\""]
	quest.3982EBB723ECD32B.quest_subtitle: "Chapter Gate"
	quest.3982EBB723ECD32B.title: "We Hold"
	quest.3C776AC2E9F16693.quest_desc: ["Walk into the ruined city. Towers, streets, stations, all of it empty.\\n\\nThe Builders left in a hurry. Doors open, tables set. &7Journals tell you the city was evacuated &oby rail&r&7, district by district."]
	quest.3C776AC2E9F16693.title: "The Endless City"
	quest.3EA616D994247713.quest_desc: ["Others went up, to islands above the sky. &7(A glowstone portal frame, lit with water.)&r"]
	quest.3EA616D994247713.title: "Above the Clouds"
	quest.400E1D5A58994D60.quest_desc: ["A tesla coil zaps anything that gets close. The Builders lined their stations with them. Most are dead now. Yours won't be."]
	quest.400E1D5A58994D60.title: "Lightning in a Box"
	quest.405BCA1705D5D5C2.quest_desc: ["Check this once the sun comes up.\\n\\nThe ruins on the horizon go on forever. Somebody built all of this. Somebody ran those trains.\\n\\n&7Where did they go?&r"]
	quest.405BCA1705D5D5C2.quest_subtitle: "Chapter Gate"
	quest.405BCA1705D5D5C2.title: "Survive the First Night"
	quest.47A3E909D9DFB68F.quest_desc: ["A fungus is spreading out of the deep places, turning everything it touches. It grows. It &olearns&r.\\n\\nThis one you &ecan&r fight. Charge in, together. Burn it back."]
	quest.47A3E909D9DFB68F.title: "The Infection"
	quest.4DCCAC87EF742EDA.quest_desc: ["A beast sleeps in the ice. Wake it only if you're ready."]
	quest.4DCCAC87EF742EDA.title: "The Frostmaw"
	quest.50A01628A298C883.quest_desc: ["Knocking at the door, in the middle of the night, when everyone is home.\\n\\nThat is &cthe Knocker&r. Light, locked doors, company. Check this once you have heard it and lived."]
	quest.50A01628A298C883.title: "Do Not Answer"
	quest.51AD8034176BFA4A.quest_desc: ["A chunk loader keeps your trains running when nobody is near them. The Builders' trains never stopped. Now you know why."]
	quest.51AD8034176BFA4A.title: "Keep Them Running"
	quest.5511EC0E407018FF.quest_desc: ["First rule of this place: &ethe dark is not empty&r.\\n\\nThings out here hunt where the light does not reach. Keep torches on you. Always."]
	quest.5511EC0E407018FF.title: "Light Is Life"
	quest.552775E8592A7452.quest_desc: ["Wall in your settlement. Gates you can close. Light on every corner."]
	quest.552775E8592A7452.title: "Walls"
	quest.5584D611223D744A.quest_desc: ["Cogwheels carry rotation. Everything here runs on &erotation&r: the doors, the lights, the trains."]
	quest.5584D611223D744A.title: "Things That Turn"
	quest.58E40364210E9089.quest_desc: ["And some went down. Too far down. This is where the things below came from."]
	quest.58E40364210E9089.title: "Under Everything"
	quest.5A4A0B7DF4784B7E.quest_desc: ["Andesite and iron nuggets make &eandesite alloy&r, the base of every Builder machine. Mix it in a crafting grid to start."]
	quest.5A4A0B7DF4784B7E.title: "Builder Metal"
	quest.62670F45399130E7.quest_desc: ["A backpack holds what you cannot carry. If you die, your things stay on your &ecorpse&r. Go back for them... carefully."]
	quest.62670F45399130E7.title: "Pack Light, Pack Smart"
	quest.64F936ADB8D3EDAE.quest_desc: ["In the tunnels: footsteps that stop when yours stop. A shape that runs on all fours.\\n\\nThat is &cthe Cave Dweller&r. It hunts in the dark under the city. Check this when you have seen it and gotten away."]
	quest.64F936ADB8D3EDAE.title: "The Dweller"
	quest.6BFB5539D1CEC86A.quest_desc: ["You wake on a cold platform. The train that brought you is already pulling away, &oon schedule&r, with no driver.\\n\\nThis book is your journal. The story is in here, a little at a time.\\n\\nClick the checkmark to begin."]
	quest.6BFB5539D1CEC86A.title: "Last Stop"
	quest.6C534E757D9A0FE8.quest_desc: ["Propellers, balloons, a frame. The Builders flew before they fell."]
	quest.6C534E757D9A0FE8.title: "Lift"
	quest.6E36006FC0490D84.quest_desc: ["Build and assemble a train at a station. Check this when it moves.\\n\\nTrains are how you travel here. &7There are no teleports. There is no shortcut.&r"]
	quest.6E36006FC0490D84.title: "Your Own Train"
	quest.7A7A2ABF199241D6.quest_desc: ["Some Builders fled into a forest where it is always dusk. Find their way in. &7(A portal of flowers around a pool of water, and a diamond thrown in.)&r"]
	quest.7A7A2ABF199241D6.title: "The Forest at Dusk"
	quest.7C354DBEC8EEE180.quest_desc: ["Hover any item and press &eR&r for its recipe, &eU&r for its uses. Press &eM&r for the map. There is no minimap here. &7Nobody should know exactly where they are.&r\\n\\nTalk with your friends using &eproximity voice chat&r: they only hear you when you are close. So does everything else."]
	quest.7C354DBEC8EEE180.title: "Read the Signs"
	quest.7D0BC39519E50BC5.quest_desc: ["Your first district has power and light. Others will gather here.\\n\\nA timetable on the station wall still lists every stop. One line is crossed out in red: &c\"BELOW. DO NOT SERVICE.\"&r"]
	quest.7D0BC39519E50BC5.quest_subtitle: "Chapter Gate"
	quest.7D0BC39519E50BC5.title: "District One Is Lit"
	quest.7FF8B824E03C98EF.quest_desc: ["A Builder note, scratched into a wall:\\n&o\"They don't come where the lights are on. Keep the district lit. KEEP IT LIT.\"&r\\n\\nLight up a safe zone around your base."]
	quest.7FF8B824E03C98EF.title: "Power Is Safety"
	reward_table.2828F94F33A092AF.title: "Line Authority Vault"
	reward_table.4D21E7414940E717.title: "Builder Cache"
	reward_table.7993104BCF29421E.title: "Scavenged Supplies"
}
